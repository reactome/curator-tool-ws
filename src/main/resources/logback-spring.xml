<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Read the log directory from application.properties (falls back to "logs") -->
    <springProperty name="LOG_DIR" source="logging.dir" defaultValue="logs"/>

    <property name="LOG_FILE"    value="${LOG_DIR}/curator-tool-ws.log"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level [%thread] %logger{36}: %msg%n"/>

    <!-- ── Console appender ──────────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── Rolling file appender ─────────────────────────────────────────── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll over daily; keep 30 days of history; cap total size at 500 MB -->
            <fileNamePattern>${LOG_DIR}/curator-tool-ws.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ── Audit file appender (for curation write actions) ────────────────── -->
    <property name="AUDIT_LOG_FILE" value="${LOG_DIR}/curation-audit.log"/>
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AUDIT_LOG_FILE}</file>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll over daily; keep 90 days of audit history; cap total size at 1 GB -->
            <fileNamePattern>${LOG_DIR}/curation-audit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

