<!--         <appender-ref ref="FILE"/> -->
<!--     </logger> -->

    <!-- ── Audit logger for curation write actions ──────────────────────────── -->
    <logger name="curation-audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <!-- ── Root logger: everything goes to both console and file ─────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
