# Template for application.properties.local (local development) and application.properties.server
# (production). Copy it to one of those names and edit the values marked "CHANGE ME". The copies are
# git-ignored, so they never get committed. See "Configuration" in README.md.
#
# Credentials are not stored here. They come from environment variables, or from a .env file in the
# working directory (copy .env.example to .env and fill it in). Real environment variables win over .env.
spring.config.import=optional:file:.env[.properties]
spring.neo4j.uri=${NEO4J_URI:bolt://localhost:7687}
spring.neo4j.authentication.username=${NEO4J_USER:neo4j}
spring.neo4j.authentication.password=${NEO4J_PASSWORD}


# For SchemaRepository: Make sure the graph database name is correct
# usually graph.db or neo4j. Make sure it is the same as the database
# used in the above neo4j.uri!
spring.data.neo4j.database=graph.db

logging.level.org.springframework.data.neo4j=INFO
logging.level.org.springframework.security=INFO
logging.level.org.reactome.server.tools.reaction.exporter=INFO
# reaction-exporter's ReactionGraphFactory issues a Cypher query (finding preceding/following
# reactions in a pathway diagram) using RETURN-with-implicit-grouping syntax that Neo4j has
# deprecated but still fully supports - the query works correctly, this just silences the
# per-request "FeatureDeprecationWarning" notice, which we can't fix without patching that
# third-party jar's compiled Cypher string.
logging.level.org.springframework.data.neo4j.cypher=ERROR
# diagram-converter's ProcessFactory validates legacy PathwayDiagram XML against process_schema.xsd
# with a JAXB unmarshaller; some older/legacy diagrams don't fully conform (e.g. missing an
# optional element before another), which the unmarshaller tolerates and recovers from (rendering
# continues normally), but ProcessFactory still logs every such event under the literal logger
# name "converter" at ERROR. Silencing since it isn't actionable without patching that jar.
logging.level.converter=OFF
# Directory for the rolling log file (used by logback-spring.xml)
logging.dir=logs

# The URL of the Angular front-end (curator-tool-frontend)
clientUrl=http://localhost:4200

# The following is copied from content-service
#The bean 'lazyFetchAspect', defined in graph core Main.class
spring.main.allow-bean-definition-overriding=true

# Used to fetch ontology terms from the EBI OLS REST API
ols.base-url=https://www.ebi.ac.uk/ols4/api/ontologies/

# Used to fetch pubmed detailed information
pubmedUrl1=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&retmode=xml&id=
pubmedUrl2=

# Used to fetch UniProt detailed information
uniprotDownloadUrl=https://www.uniprot.org/uniprot/
uniprotXmlFormat=.xml
uniprotFlatFormat=.txt

# CHANGE ME: Used to persist instances worked by curators
file_repo_dir=/path/to/curator-tool-ws/file_repo
# CHANGE ME: Used for handling pathway diagrams
diagram_graph_dir=/path/to/web_curator_tool/diagram/graph
diagram_cytoscape_dir=/path/to/web_curator_tool/diagram/cytoscape
# CHANGE ME: Root directory for storing files related to figure generation. This is used by the figure
# generation module to store temporary files and generated figures. Make sure this directory exists and
# has write permissions.
figure_root_dir=/path/to/web_curator_tool

# To control the time for reusing InstanceEdit (time unit: second)
instance_edit_duration=60

# JWT Token Configuration (time unit: milliseconds)
# 5 minutes
jwt.access-token-time=300000
# 20 minutes
jwt.idle-token-time=1200000
# 24 hours. Nobody will use the refresh token to get a new access token after 24 hours. So it is basically the same as the access token time.
jwt.refresh-token-time=86400000

# File backup configuration - maximum number of backup files to keep
staged-file.backup.max-count=50

# CHANGE ME: a flag to control whether the application is running at local development environment.
# This is used to control some configurations that are only suitable for local development.
# Use true for the production server.
isProduction=false

server.port=9090

# Used to manage the user database in an embedded h2 database
# Make sure this is changed at the server: There is no need to change this. Just make sure
# the files in data are copied to the server.
# Don't lock the file so that we can test at local dev
spring.datasource.url=${DATASOURCE_URL:jdbc:h2:file:./data/reactome_h2;DB_CLOSE_DELAY=-1;FILE_LOCK=NO}
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=${DATASOURCE_USER}
spring.datasource.password=${DATASOURCE_PASSWORD}
spring.h2.console.enabled=true
spring.jpa.hibernate.ddl-auto=update
# JPA (Hibernate) configuration
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.H2Dialect
